{
  "name": "@prmichaelsen/agentbase",
  "version": "1.0.1",
  "description": "Instagram MCP server using Graph API v21.0",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    },
    "./factory": {
      "types": "./build/server-factory.d.ts",
      "import": "./build/server-factory.js"
    },
    "./client": {
      "types": "./build/instagram-client.d.ts",
      "import": "./build/instagram-client.js"
    },
    "./tools": {
      "types": "./build/tools/index.d.ts",
      "import": "./build/tools/index.js"
    },
    "./types": {
      "types": "./build/types.d.ts",
      "import": "./build/types.js"
    }
  },
  "scripts": {
    "build": "npm run build:types && npm run build:bundle",
    "build:types": "tsc --emitDeclarationOnly",
    "build:bundle": "node esbuild.build.js",
    "watch": "node esbuild.watch.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "instagram",
    "graph-api",
    "multi-tenant"
  ],
  "author": "prmichaelsen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/prmichaelsen/agentbase.git"
  },
  "bugs": {
    "url": "https://github.com/prmichaelsen/agentbase/issues"
  },
  "homepage": "https://github.com/prmichaelsen/agentbase#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "glob": "^13.0.1",
    "typescript": "^5.7.2"
  }
}
